# 你在浏览器里打开 dashboard 用的地址（必须和实际访问地址一致，Era 登录完成后会跳回这里）
# 用 Tailscale Serve 时类似：https://你的机器名.你的tailnet.ts.net
PUBLIC_URL=http://localhost:8080
PORT=8080

# 可选：生成理财建议用。不填则报告页的“生成建议”按钮不显示
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 多久从 Era 同步一次（小时）。Organize 套餐每月 1000 次 MCP 调用，每次同步约 3 次
SYNC_HOURS=6
# 第一次同步从哪天开始拉历史
HISTORY_START=2026-04-01
